# Your ntfy.sh topic name (pick anything unique, e.g. nick-mlb-blowout-7x2q).
# Install the ntfy app and subscribe to this same topic to get the push alerts.
# Leave blank to just print alerts to the console instead.
NTFY_TOPIC=

# Minimum run differential to count as a "blowout" when a position player pitches.
BLOWOUT_RUN_DIFF=6

# How often (seconds) to poll live games.
POLL_INTERVAL_SECONDS=30

# The Odds API (the-odds-api.com) — free tier: 500 credits/month.
ODDS_API_KEY=
# How often (seconds) to refresh the dashboard's odds snapshot.
#   500 credit/month free tier -> 3600 (1 hour)
#   20K credit/month $30 tier  -> 300 (5 min)  <- default
# Cost per refresh = 4 credits (spreads + h2h + totals + alternate_spreads).
ODDS_REFRESH_SECONDS=300
# Which sportsbook to display on the dashboard.
# Options include: draftkings, fanduel, betmgm, caesars, pointsbetus, williamhill_us
ODDS_BOOK=draftkings

# --- Rule engine v2 ---
# Floor inning for the ordinary "blowout" tier -- never alert before this
# inning regardless of run differential (position players pitching earlier
# than this are more likely an emergency/injury than a real concession).
MIN_INNING=5
# Run differential needed in innings MIN_INNING-6. Defaults to BLOWOUT_RUN_DIFF if unset.
RUN_DIFF_MID=6
# Run differential needed in innings 7+ (lower bar -- late-game concessions need less margin).
RUN_DIFF_LATE=4
# Prior relievers already used by the losing team before the position player
# entered. Meeting this triggers a separate, higher-priority "bullpen
# exhausted" alert that bypasses MIN_INNING/RUN_DIFF entirely.
BULLPEN_EXHAUSTION_COUNT=4

# How often (seconds) to push a slate-wide summary of every live game,
# ranked biggest lead to smallest, independent of individual alerts.
SUMMARY_INTERVAL_SECONDS=3600

# Big Lead Watch: run-differential-only tier, independent of pitching.
# Fires the first time a game's lead crosses this, any inning, and again
# every BIG_LEAD_STEP runs after that as it keeps growing. Also arms the
# Pitcher Change Alert tier (urgent ping on any new reliever) for that game.
BIG_LEAD_THRESHOLD=6
BIG_LEAD_STEP=3

# Extreme Lead Alert: once the lead is out-of-hand, re-alert on tighter
# increments (default: 10, 12, 14, 16, ...) at urgent priority. Big Lead
# self-suppresses inside this territory so the two tiers don't double-fire
# at overlapping buckets. Also amps up the Pitcher Change Alert wording
# (title becomes "Pitcher Change Alert (Extreme)") for that game.
EXTREME_LEAD_THRESHOLD=10
EXTREME_LEAD_STEP=2
